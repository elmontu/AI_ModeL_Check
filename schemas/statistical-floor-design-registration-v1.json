{
  "additionalProperties": false,
  "description": "Outcome-free design facts frozen before a generic floor is observed.",
  "properties": {
    "analyzer": {
      "enum": [
        "attack",
        "controlled_inference",
        "llm_canary"
      ],
      "title": "Analyzer",
      "type": "string"
    },
    "dataset_snapshot_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Dataset Snapshot Sha256",
      "type": "string"
    },
    "decision_metric": {
      "enum": [
        "bayes_linkage_success",
        "incremental_bayes_linkage_success",
        "worst_observation_success",
        "membership_tpr_at_fpr",
        "equal_prior_membership_success",
        "finite_secret_exact_guess_success",
        "attribute_attack_success",
        "incremental_attribute_attack_success",
        "reconstruction_success",
        "incremental_reconstruction_success"
      ],
      "title": "Decision Metric",
      "type": "string"
    },
    "execution_plan_sha256": {
      "description": "Pre-outcome commitment to the calibration split, search space, threshold/scoring rule, query schedule, and model decoding settings.",
      "pattern": "^[0-9a-f]{64}$",
      "title": "Execution Plan Sha256",
      "type": "string"
    },
    "member_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:-]+$",
      "title": "Member Id",
      "type": "string"
    },
    "notes": {
      "default": "",
      "maxLength": 4096,
      "title": "Notes",
      "type": "string"
    },
    "planned_control_trials": {
      "minimum": 0,
      "title": "Planned Control Trials",
      "type": "integer"
    },
    "planned_primary_trials": {
      "exclusiveMinimum": 0,
      "title": "Planned Primary Trials",
      "type": "integer"
    },
    "population_scope_id": {
      "maxLength": 128,
      "minLength": 3,
      "pattern": "^[A-Za-z0-9._:-]+$",
      "title": "Population Scope Id",
      "type": "string"
    },
    "procedure_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Procedure Sha256",
      "type": "string"
    },
    "random_seed": {
      "minimum": 0,
      "title": "Random Seed",
      "type": "integer"
    },
    "registered_at": {
      "format": "date-time",
      "title": "Registered At",
      "type": "string"
    },
    "registration_id": {
      "maxLength": 128,
      "minLength": 3,
      "pattern": "^[A-Za-z0-9._:-]+$",
      "title": "Registration Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "sealed_assignment_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sealed Assignment Sha256"
    },
    "stopping_rule": {
      "maxLength": 2048,
      "minLength": 1,
      "title": "Stopping Rule",
      "type": "string"
    },
    "target_fpr": {
      "anyOf": [
        {
          "exclusiveMaximum": 1.0,
          "exclusiveMinimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Target Fpr"
    },
    "threat_id": {
      "maxLength": 128,
      "minLength": 3,
      "pattern": "^[A-Za-z0-9._:-]+$",
      "title": "Threat Id",
      "type": "string"
    }
  },
  "required": [
    "registration_id",
    "analyzer",
    "threat_id",
    "population_scope_id",
    "member_id",
    "decision_metric",
    "registered_at",
    "dataset_snapshot_sha256",
    "procedure_sha256",
    "execution_plan_sha256",
    "random_seed",
    "stopping_rule",
    "planned_primary_trials",
    "planned_control_trials"
  ],
  "title": "StatisticalFloorDesignRegistration",
  "type": "object"
}
