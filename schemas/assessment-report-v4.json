          },
          "minItems": 1,
          "title": "Input Modalities",
          "type": "array"
        },
        "output_modalities": {
          "items": {
            "$ref": "#/$defs/DataModality"
          },
          "minItems": 1,
          "title": "Output Modalities",
          "type": "array"
        },
        "stateful": {
          "default": false,
          "title": "Stateful",
          "type": "boolean"
        },
        "task": {
          "$ref": "#/$defs/ModelTask"
        },
        "training_paradigm": {
          "$ref": "#/$defs/TrainingParadigm"
        }
      },
      "required": [
        "task",
        "input_modalities",
        "output_modalities",
        "training_paradigm"
      ],
      "title": "ModelProfile",
      "type": "object"
    },
