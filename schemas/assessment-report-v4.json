        "aggregates": {
          "title": "Aggregates",
          "type": "boolean"
        },
        "custom_channels": {
          "items": {
            "type": "string"
          },
          "title": "Custom Channels",
          "type": "array"
        },
        "downloadable_files": {
          "items": {
            "type": "string"
          },
          "title": "Downloadable Files",
          "type": "array"
        },
        "embeddings": {
          "title": "Embeddings",
          "type": "boolean"
        },
        "explanations": {
          "title": "Explanations",
          "type": "boolean"
        },
        "gradients": {
          "title": "Gradients",
          "type": "boolean"
        },
        "labels": {
          "title": "Labels",
          "type": "boolean"
        },
        "logits": {
          "title": "Logits",
          "type": "boolean"
        },
        "parameters": {
          "title": "Parameters",
          "type": "boolean"
        },
        "probabilities": {
          "title": "Probabilities",
          "type": "boolean"
