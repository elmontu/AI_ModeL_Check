{
  "$defs": {
    "DataModality": {
      "enum": [
        "tabular",
        "text",
        "image",
        "audio",
        "video",
        "time_series",
        "graph",
        "geospatial",
        "embedding",
        "action",
        "multimodal",
        "custom"
      ],
      "title": "DataModality",
      "type": "string"
    },
    "EvidenceClass": {
      "enum": [
        "exact",
        "ceiling",
        "floor",
        "screen"
      ],
      "title": "EvidenceClass",
      "type": "string"
    },
    "EvidenceCoverage": {
      "enum": [
        "complete_interface",
        "named_projection",
        "screen_only"
      ],
      "title": "EvidenceCoverage",
      "type": "string"
    },
    "EvidenceRecord": {
      "additionalProperties": false,
      "properties": {
        "analyzer": {
          "title": "Analyzer",
          "type": "string"
        },
        "artifact_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Artifact Sha256"
        },
        "assumptions": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Assumptions",
          "type": "array"
        },
        "baseline": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Baseline"
        },
        "can_block": {
          "title": "Can Block",
          "type": "boolean"
        },
        "can_clear": {
          "title": "Can Clear",
          "type": "boolean"
        },
        "coverage": {
          "$ref": "#/$defs/EvidenceCoverage",
          "default": "screen_only"
        },
        "decision_game_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Decision Game Sha256"
        },
        "details": {
          "additionalProperties": true,
          "title": "Details",
          "type": "object"
        },
        "evidence_class": {
          "$ref": "#/$defs/EvidenceClass"
        },
        "evidence_id": {
          "title": "Evidence Id",
          "type": "string"
        },
        "interface_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Interface Sha256"
        },
        "limitations": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "lower": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lower"
        },
        "metric": {
          "title": "Metric",
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "policy_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Policy Sha256",
          "type": "string"
        },
        "population_scope_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9._:-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Population Scope Id"
        },
        "population_scope_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Population Scope Sha256"
        },
        "realizability": {
          "$ref": "#/$defs/Realizability"
        },
        "release_contract_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Release Contract Sha256",
          "type": "string"
        },
        "release_id": {
          "maxLength": 128,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "title": "Release Id",
          "type": "string"
        },
        "threat_id": {
          "title": "Threat Id",
          "type": "string"
        },
        "upper": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Upper"
        },
        "value": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "evidence_id",
        "threat_id",
        "analyzer",
        "release_id",
        "release_contract_sha256",
        "policy_sha256",
        "observed_at",
        "evidence_class",
        "metric",
        "realizability",
        "can_clear",
        "can_block"
      ],
      "title": "EvidenceRecord",
      "type": "object"
    },
    "InterfaceContract": {
      "additionalProperties": false,
      "properties": {
        "access": {
          "enum": [
            "aggregate",
            "label",
            "score",
            "text",
            "embedding",
            "gradient",
            "weights",
            "full_artifact"
          ],
          "title": "Access",
          "type": "string"
        },
        "adaptive_queries": {
          "default": false,
          "title": "Adaptive Queries",
          "type": "boolean"
        },
        "authenticated": {
          "default": false,
          "title": "Authenticated",
          "type": "boolean"
        },
        "llm_protocol": {
          "anyOf": [
            {
              "$ref": "#/$defs/LlmProtocolContract"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "notes": {
          "default": "",
          "title": "Notes",
          "type": "string"
        },
        "outputs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Outputs",
          "type": "array"
        },
        "precision_bits": {
          "anyOf": [
            {
              "maximum": 4096,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Precision Bits"
        },
        "protocol_type": {
          "default": "predictive",
          "enum": [
            "predictive",
            "interactive_llm"
          ],
          "title": "Protocol Type",
          "type": "string"
        },
        "query_budget": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Query Budget"
        },
        "rate_limited": {
          "default": false,
          "title": "Rate Limited",
          "type": "boolean"
        }
      },
      "required": [
        "access"
      ],
      "title": "InterfaceContract",
      "type": "object"
    },
    "LlmProtocolContract": {
      "additionalProperties": false,
      "properties": {
        "adapter_sha256s": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Adapter Sha256S",
          "type": "array"
        },
        "decoding_parameters": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "minProperties": 1,
          "title": "Decoding Parameters",
          "type": "object"
        },
        "filter_bundle_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Filter Bundle Sha256"
        },
        "logging_mode": {
          "enum": [
            "none",
            "security_only",
            "full_transcript"
          ],
          "title": "Logging Mode",
          "type": "string"
        },
        "maximum_concurrent_sessions": {
          "exclusiveMinimum": 0,
          "title": "Maximum Concurrent Sessions",
          "type": "integer"
        },
        "maximum_lifetime_queries": {
          "exclusiveMinimum": 0,
          "title": "Maximum Lifetime Queries",
          "type": "integer"
        },
        "maximum_session_tokens": {
          "exclusiveMinimum": 0,
          "title": "Maximum Session Tokens",
          "type": "integer"
        },
        "memory_mode": {
          "enum": [
            "none",
            "session",
            "persistent"
          ],
          "title": "Memory Mode",
          "type": "string"
        },
        "memory_ttl_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Memory Ttl Seconds"
        },
        "model_identifier": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Model Identifier",
          "type": "string"
        },
        "model_provider": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Model Provider",
          "type": "string"
        },
        "model_version": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Model Version",
          "type": "string"
        },
        "provider_retention_days": {
          "minimum": 0,
          "title": "Provider Retention Days",
          "type": "integer"
        },
        "reset_semantics": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Reset Semantics",
          "type": "string"
        },
        "retrieval_corpus_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retrieval Corpus Sha256"
        },
        "retriever_config_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retriever Config Sha256"
        },
        "system_prompt_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "System Prompt Sha256",
          "type": "string"
        },
        "tokenizer_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Tokenizer Sha256",
          "type": "string"
        },
        "tool_names": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Tool Names",
          "type": "array"
        },
        "tool_policy_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Policy Sha256"
        },
        "update_policy": {
          "enum": [
            "immutable",
            "versioned_reassessment_required"
          ],
          "title": "Update Policy",
          "type": "string"
        },
        "valid_until": {
          "format": "date-time",
          "title": "Valid Until",
          "type": "string"
        }
      },
      "required": [
        "model_provider",
        "model_identifier",
        "model_version",
        "tokenizer_sha256",
        "decoding_parameters",
        "system_prompt_sha256",
        "memory_mode",
        "logging_mode",
        "provider_retention_days",
        "maximum_session_tokens",
        "maximum_lifetime_queries",
        "maximum_concurrent_sessions",
        "reset_semantics",
        "update_policy",
        "valid_until"
      ],
      "title": "LlmProtocolContract",
      "type": "object"
    },
    "ModelProfile": {
      "additionalProperties": false,
      "properties": {
        "component_model_families": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Component Model Families",
          "type": "array"
        },
        "custom_task_definition": {
          "anyOf": [
            {
              "maxLength": 2048,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Custom Task Definition"
        },
        "generative": {
          "default": false,
          "title": "Generative",
          "type": "boolean"
        },
        "input_modalities": {
          "items": {
            "$ref": "#/$defs/DataModality"
          },
          "minItems": 1,
          "title": "Input Modalities",
          "type": "array"
        },
        "output_modalities": {
          "items": {
            "$ref": "#/$defs/DataModality"
          },
          "minItems": 1,
          "title": "Output Modalities",
          "type": "array"
        },
        "stateful": {
          "default": false,
          "title": "Stateful",
          "type": "boolean"
        },
        "task": {
          "$ref": "#/$defs/ModelTask"
        },
        "training_paradigm": {
          "$ref": "#/$defs/TrainingParadigm"
        }
      },
      "required": [
        "task",
        "input_modalities",
        "output_modalities",
        "training_paradigm"
      ],
      "title": "ModelProfile",
      "type": "object"
    },
    "ModelTask": {
      "enum": [
        "classification",
        "regression",
        "ranking",
        "recommendation",
        "forecasting",
        "clustering",
        "anomaly_detection",
        "representation",
        "generation",
        "retrieval",
        "control",
        "decision_support",
        "custom"
      ],
      "title": "ModelTask",
      "type": "string"
    },
    "OverallVerdict": {
      "enum": [
        "clear",
        "block",
        "inconclusive"
      ],
      "title": "OverallVerdict",
      "type": "string"
    },
    "PopulationScope": {
      "additionalProperties": false,
      "properties": {
        "custom_unit_definition": {
          "anyOf": [
            {
              "maxLength": 1024,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Custom Unit Definition"
        },
        "data_steward": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Data Steward",
          "type": "string"
        },
        "exclusion_criteria": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Exclusion Criteria",
          "type": "array"
        },
        "inclusion_criteria": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Inclusion Criteria",
          "type": "array"
        },
        "jurisdictions": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Jurisdictions",
          "type": "array"
        },
        "name": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "notes": {
          "default": "",
          "title": "Notes",
          "type": "string"
        },
        "population_snapshot_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Population Snapshot Sha256"
        },
        "reference_date": {
          "format": "date",
          "title": "Reference Date",
          "type": "string"
        },
        "scope_id": {
          "maxLength": 128,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "title": "Scope Id",
          "type": "string"
        },
        "size": {
          "$ref": "#/$defs/PopulationSize"
        },
        "subgroup_dimensions": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Subgroup Dimensions",
          "type": "array"
        },
        "unit_kind": {
          "$ref": "#/$defs/PopulationUnitKind"
        },
        "universe_definition": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Universe Definition",
          "type": "string"
        },
        "valid_until": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid Until"
        }
      },
      "required": [
        "scope_id",
        "name",
        "unit_kind",
        "universe_definition",
        "inclusion_criteria",
        "jurisdictions",
        "reference_date",
        "size",
        "data_steward"
      ],
      "title": "PopulationScope",
      "type": "object"
    },
    "PopulationSize": {
      "additionalProperties": false,
      "properties": {
        "basis": {
          "$ref": "#/$defs/PopulationSizeBasis"
        },
        "lower_bound": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lower Bound"
        },
        "measured_at": {
          "format": "date-time",
          "title": "Measured At",
          "type": "string"
        },
        "point_estimate": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Point Estimate"
        },
        "source": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "upper_bound": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Upper Bound"
        }
      },
      "required": [
        "basis",
        "source",
        "measured_at"
      ],
      "title": "PopulationSize",
      "type": "object"
    },
    "PopulationSizeBasis": {
      "enum": [
        "exact_registry",
        "bounded_estimate",
        "point_estimate",
        "open_dynamic"
      ],
      "title": "PopulationSizeBasis",
      "type": "string"
    },
    "PopulationUnitKind": {
      "enum": [
        "person",
        "household",
        "organization",
        "establishment",
        "record",
        "device",
        "transaction",
        "event",
        "session",
        "custom"
      ],
      "title": "PopulationUnitKind",
      "type": "string"
    },
    "Realizability": {
      "enum": [
        "recipient_realizable",
        "auditor_only",
        "population_model",
        "not_applicable"
      ],
      "title": "Realizability",
      "type": "string"
    },
    "ThreatDecision": {
      "additionalProperties": false,
      "properties": {
        "assessed_artifact_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Assessed Artifact Sha256",
          "type": "string"
        },
        "assessed_interface_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Assessed Interface Sha256",
          "type": "string"
        },
        "assessed_policy_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Assessed Policy Sha256",
          "type": "string"
        },
        "assessed_release_contract_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Assessed Release Contract Sha256",
          "type": "string"
        },
        "decision_game_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Decision Game Sha256",
          "type": "string"
        },
        "decision_metric": {
          "enum": [
            "bayes_linkage_success",
            "incremental_bayes_linkage_success",
            "worst_observation_success",
            "membership_tpr_at_fpr",
            "equal_prior_membership_success",
            "finite_secret_exact_guess_success",
            "attribute_attack_success",
            "incremental_attribute_attack_success",
            "reconstruction_success",
            "incremental_reconstruction_success"
          ],
          "title": "Decision Metric",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "kind": {
          "$ref": "#/$defs/ThreatKind"
        },
        "lower_bound": {
          "title": "Lower Bound",
          "type": "number"
        },
        "mandatory": {
          "title": "Mandatory",
          "type": "boolean"
        },
        "population_scope_id": {
          "title": "Population Scope Id",
          "type": "string"
        },
        "population_scope_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Population Scope Sha256",
          "type": "string"
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        },
        "threat_id": {
          "title": "Threat Id",
          "type": "string"
        },
        "tolerance": {
          "title": "Tolerance",
          "type": "number"
        },
        "tolerance_basis": {
          "enum": [
            "absolute",
            "incremental"
          ],
          "title": "Tolerance Basis",
          "type": "string"
        },
        "upper_bound": {
          "title": "Upper Bound",
          "type": "number"
        },
        "verdict": {
          "$ref": "#/$defs/Verdict"
        }
      },
      "required": [
        "threat_id",
        "population_scope_id",
        "population_scope_sha256",
        "decision_game_sha256",
        "assessed_interface_sha256",
        "assessed_artifact_sha256",
        "assessed_release_contract_sha256",
        "assessed_policy_sha256",
        "decision_metric",
        "kind",
        "mandatory",
        "tolerance",
        "tolerance_basis",
        "lower_bound",
        "upper_bound",
        "verdict",
        "evidence_ids",
        "reasons"
      ],
      "title": "ThreatDecision",
      "type": "object"
    },
    "ThreatKind": {
      "enum": [
        "linkage",
        "membership",
        "attribute",
        "reconstruction"
      ],
      "title": "ThreatKind",
      "type": "string"
    },
    "TrainingParadigm": {
      "enum": [
        "supervised",
        "semi_supervised",
        "self_supervised",
        "unsupervised",
        "reinforcement_learning",
        "in_context_or_prompted",
        "hybrid",
        "custom"
      ],
      "title": "TrainingParadigm",
