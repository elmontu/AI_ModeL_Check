          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "title": "Control Id",
          "type": "string"
        },
        "control_kind": {
          "enum": [
            "known_leak_binomial",
            "expected_flag"
          ],
          "title": "Control Kind",
          "type": "string"
        },
        "minimum_detection_lower_bound": {
          "exclusiveMinimum": 0.0,
          "maximum": 1.0,
          "title": "Minimum Detection Lower Bound",
          "type": "number"
        },
        "minimum_trials": {
          "exclusiveMinimum": 0,
          "title": "Minimum Trials",
          "type": "integer"
        },
        "reference_artifact_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Reference Artifact Sha256",
          "type": "string"
        },
        "reference_dataset_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Reference Dataset Sha256",
          "type": "string"
        }
      },
      "required": [
        "control_id",
        "attack_id",
        "control_kind",
        "reference_artifact_sha256",
        "reference_dataset_sha256",
        "minimum_trials",
        "minimum_detection_lower_bound",
        "confidence"
      ],
      "title": "AttackPositiveControlPlan",
      "type": "object"
    },
    "AttackPositiveControlResult": {
      "additionalProperties": false,
      "properties": {
        "attack_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "title": "Attack Id",
          "type": "string"
        },
        "attack_version": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "title": "Attack Version",
          "type": "string"
        },
        "control_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "title": "Control Id",
          "type": "string"
        },
        "expected_flag_observed": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Flag Observed"
        },
        "implementation_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Implementation Sha256",
          "type": "string"
        },
        "raw_result_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Raw Result Sha256",
          "type": "string"
        },
        "reported_detection_lower_bound": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reported Detection Lower Bound"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "service_id": {
          "maxLength": 128,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "title": "Service Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "succeeded",
            "failed",
            "timed_out"
