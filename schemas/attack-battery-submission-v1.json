      "required": [
        "tool",
        "tool_version",
        "producer",
        "configuration_path",
        "source_path",
        "source_sha256",
        "bound_fields"
      ],
      "title": "AnalyzerProvenance",
      "type": "object"
    },
    "AttackBatteryConfiguration": {
      "additionalProperties": false,
      "properties": {
        "catalog_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Catalog Sha256",
          "type": "string"
        },
        "configuration_id": {
          "maxLength": 128,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "title": "Configuration Id",
          "type": "string"
        },
        "frozen_at": {
          "format": "date-time",
          "title": "Frozen At",
          "type": "string"
        },
        "multiplicity_method": {
          "const": "bonferroni",
          "title": "Multiplicity Method",
          "type": "string"
        },
        "positive_controls": {
          "items": {
            "$ref": "#/$defs/AttackPositiveControlPlan"
          },
          "minItems": 1,
          "title": "Positive Controls",
          "type": "array"
        },
        "resource_limits": {
          "$ref": "#/$defs/AttackResourceLimits"
        },
        "runs": {
          "items": {
            "$ref": "#/$defs/AttackRunPlan"
          },
          "minItems": 1,
          "title": "Runs",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "stopping_rule": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Stopping Rule",
          "type": "string"
        }
      },
      "required": [
        "configuration_id",
        "catalog_sha256",
        "frozen_at",
        "resource_limits",
        "runs",
        "positive_controls",
        "stopping_rule",
        "multiplicity_method"
      ],
