          "default": null,
          "title": "Successes"
        },
        "trials": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trials"
        }
      },
      "required": [
        "control_id",
        "attack_id",
        "service_id",
        "attack_version",
        "implementation_sha256",
        "status",
        "raw_result_sha256"
