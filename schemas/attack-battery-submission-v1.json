        },
        "writable_key_path": {
          "title": "Writable Key Path",
          "type": "boolean"
        }
      },
      "required": [
        "assurance",
        "worker_image_sha256",
        "run_as_non_root",
        "no_new_privileges",
        "read_only_root_filesystem",
        "network_access",
        "writable_audit_path",
        "writable_key_path",
        "writable_governance_path",
        "read_only_mount_sha256s"
      ],
      "title": "AttackIsolationEvidence",
      "type": "object"
    },
    "AttackPositiveControlPlan": {
      "additionalProperties": false,
      "properties": {
        "attack_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "title": "Attack Id",
          "type": "string"
        },
        "confidence": {
          "exclusiveMaximum": 1.0,
          "minimum": 0.95,
