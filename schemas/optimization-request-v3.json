            "type": "string"
          },
          "title": "Downloadable Files",
          "type": "array"
        },
        "embeddings": {
          "title": "Embeddings",
          "type": "boolean"
        },
        "explanations": {
          "title": "Explanations",
          "type": "boolean"
        },
        "gradients": {
          "title": "Gradients",
          "type": "boolean"
        },
        "labels": {
          "title": "Labels",
          "type": "boolean"
        },
        "logits": {
          "title": "Logits",
          "type": "boolean"
        },
        "parameters": {
          "title": "Parameters",
          "type": "boolean"
        },
        "probabilities": {
          "title": "Probabilities",
          "type": "boolean"
        },
        "scores": {
          "title": "Scores",
          "type": "boolean"
        },
        "shipped_summary_metadata": {
          "items": {
            "type": "string"
          },
          "title": "Shipped Summary Metadata",
          "type": "array"
        },
        "text": {
          "title": "Text",
          "type": "boolean"
        }
      },
      "required": [
        "aggregates",
        "labels",
        "scores",
        "probabilities",
        "logits",
        "explanations",
        "text",
        "embeddings",
        "gradients",
        "parameters",
        "downloadable_files",
        "shipped_summary_metadata",
        "custom_channels"
      ],
      "title": "OutputChannelContract",
