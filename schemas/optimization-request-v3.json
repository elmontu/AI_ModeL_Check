{
  "$defs": {
    "AccessPathContract": {
      "additionalProperties": false,
      "description": "Non-primary paths through which a recipient could observe or control the release.",
      "properties": {
        "admin_access": {
          "enum": [
            "none",
            "read_only",
            "read_write",
            "full_control"
          ],
          "title": "Admin Access",
          "type": "string"
        },
        "admin_capabilities": {
          "items": {
            "type": "string"
          },
          "title": "Admin Capabilities",
          "type": "array"
        },
        "custom_side_channels": {
          "items": {
            "type": "string"
          },
          "title": "Custom Side Channels",
          "type": "array"
        },
        "local_access": {
          "enum": [
            "none",
            "artifact_only",
            "sandboxed_runtime",
            "process",
            "host"
          ],
          "title": "Local Access",
          "type": "string"
        },
        "local_capabilities": {
          "items": {
            "type": "string"
          },
          "title": "Local Capabilities",
          "type": "array"
        },
        "side_channels": {
          "items": {
            "enum": [
              "timing",
              "status_code",
              "error_content",
              "resource_usage",
              "cache_behavior",
              "logs",
              "telemetry",
              "custom"
            ],
            "type": "string"
          },
          "title": "Side Channels",
          "type": "array"
        }
      },
      "required": [
        "side_channels",
        "custom_side_channels",
        "admin_access",
        "admin_capabilities",
        "local_access",
        "local_capabilities"
      ],
      "title": "AccessPathContract",
      "type": "object"
    },
    "AssessmentReportReference": {
      "additionalProperties": false,
      "properties": {
        "accepted_signer_key_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Accepted Signer Key Ids",
          "type": "array"
        },
        "assessor_public_key_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Assessor Public Key Path"
        },
        "report_path": {
          "minLength": 1,
          "title": "Report Path",
          "type": "string"
        },
        "report_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Report Sha256",
          "type": "string"
        },
        "signed_manifest_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Signed Manifest Path"
        },
        "signed_manifest_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Signed Manifest Sha256"
        }
      },
      "required": [
        "report_path",
        "report_sha256"
      ],
      "title": "AssessmentReportReference",
      "type": "object"
    },
    "ControlType": {
      "enum": [
        "information_reduction",
        "access_governance"
      ],
      "title": "ControlType",
      "type": "string"
    },
    "ErrorChannelContract": {
      "additionalProperties": false,
      "description": "Declaration of transport status, errors, and retry signals.",
      "properties": {
        "documented_status_codes": {
          "items": {
            "type": "string"
          },
          "title": "Documented Status Codes",
          "type": "array"
        },
        "error_content": {
          "enum": [
            "none",
            "opaque",
            "structured",
            "free_text"
          ],
          "title": "Error Content",
          "type": "string"
        },
        "error_schema_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Schema Sha256"
        },
        "retry_metadata": {
          "title": "Retry Metadata",
          "type": "boolean"
        },
        "transport_status": {
          "enum": [
            "none",
            "http",
            "grpc",
            "custom"
          ],
          "title": "Transport Status",
          "type": "string"
        }
      },
      "required": [
        "transport_status",
        "documented_status_codes",
        "error_content",
        "retry_metadata"
      ],
      "title": "ErrorChannelContract",
      "type": "object"
    },
    "ExecutionChannelContract": {
      "additionalProperties": false,
      "description": "Batch, concurrency, and cross-request-state semantics.",
      "properties": {
        "batching": {
          "enum": [
            "none",
            "fixed",
            "variable",
            "recipient_controlled"
          ],
          "title": "Batching",
          "type": "string"
        },
        "cross_request_state": {
          "enum": [
            "none",
            "session",
            "persistent"
          ],
          "title": "Cross Request State",
          "type": "string"
        },
        "cross_request_state_ttl_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cross Request State Ttl Seconds"
        },
        "maximum_batch_size": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maximum Batch Size"
        },
        "maximum_concurrent_requests": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maximum Concurrent Requests"
        }
      },
      "required": [
        "batching",
        "cross_request_state"
      ],
      "title": "ExecutionChannelContract",
      "type": "object"
    },
    "FiniteExperiment": {
      "additionalProperties": false,
      "description": "A finite information structure P(observation | secret state).",
      "properties": {
        "artifact_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Artifact Sha256"
        },
        "channel": {
          "items": {
            "items": {
              "type": "number"
            },
            "type": "array"
          },
          "title": "Channel",
          "type": "array"
        },
        "decision_game_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Decision Game Sha256"
        },
        "experiment_id": {
          "maxLength": 128,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "title": "Experiment Id",
          "type": "string"
        },
        "interface_description": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Interface Description",
          "type": "string"
        },
        "interface_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Interface Sha256"
        },
        "observation_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Observation Ids",
          "type": "array"
        },
        "population_scope_id": {
          "maxLength": 128,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "title": "Population Scope Id",
          "type": "string"
        },
        "prior": {
          "items": {
            "type": "number"
          },
          "title": "Prior",
          "type": "array"
        },
        "state_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 2,
          "title": "State Ids",
          "type": "array"
        },
        "threat_id": {
          "maxLength": 128,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "title": "Threat Id",
          "type": "string"
        }
      },
      "required": [
        "experiment_id",
        "threat_id",
        "population_scope_id",
        "state_ids",
        "observation_ids",
        "channel",
        "prior",
        "interface_description"
      ],
      "title": "FiniteExperiment",
      "type": "object"
    },
    "GarblingCertificate": {
      "additionalProperties": false,
      "description": "Replayable exact/approximate witness that dominated is a garbling of dominant.",
      "properties": {
        "certificate_id": {
          "maxLength": 128,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "title": "Certificate Id",
          "type": "string"
        },
        "construction": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Construction",
          "type": "string"
        },
        "dominant_experiment_id": {
          "title": "Dominant Experiment Id",
          "type": "string"
        },
        "dominated_experiment_id": {
          "title": "Dominated Experiment Id",
          "type": "string"
        },
        "kernel": {
          "items": {
            "items": {
              "type": "number"
            },
            "type": "array"
          },
          "title": "Kernel",
          "type": "array"
        },
        "maximum_row_total_variation": {
          "default": 0.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Maximum Row Total Variation",
          "type": "number"
        },
        "numerical_tolerance": {
          "default": 1e-12,
          "exclusiveMinimum": 0.0,
          "maximum": 1e-09,
          "title": "Numerical Tolerance",
          "type": "number"
        }
      },
      "required": [
        "certificate_id",
        "dominant_experiment_id",
        "dominated_experiment_id",
        "kernel",
        "construction"
      ],
      "title": "GarblingCertificate",
      "type": "object"
    },
    "InterfaceContract": {
      "additionalProperties": false,
      "description": "Versioned, declarably complete recipient-observable release interface.",
      "properties": {
        "access": {
          "enum": [
            "aggregate",
            "label",
            "score",
            "text",
            "embedding",
            "gradient",
            "weights",
            "full_artifact"
          ],
          "title": "Access",
          "type": "string"
        },
        "access_paths": {
          "$ref": "#/$defs/AccessPathContract"
        },
        "adaptive_queries": {
          "title": "Adaptive Queries",
          "type": "boolean"
        },
        "authenticated": {
          "title": "Authenticated",
          "type": "boolean"
        },
        "errors": {
          "$ref": "#/$defs/ErrorChannelContract"
        },
        "execution": {
          "$ref": "#/$defs/ExecutionChannelContract"
        },
        "llm_protocol": {
          "anyOf": [
            {
              "$ref": "#/$defs/LlmProtocolContract"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "notes": {
          "default": "",
          "title": "Notes",
          "type": "string"
        },
        "output_channels": {
          "$ref": "#/$defs/OutputChannelContract"
        },
        "outputs": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Outputs",
          "type": "array"
        },
        "precision_bits": {
          "anyOf": [
            {
              "maximum": 4096,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Precision Bits"
        },
        "protocol_type": {
          "enum": [
            "predictive",
            "interactive_llm"
          ],
          "title": "Protocol Type",
          "type": "string"
        },
        "query_budget": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Query Budget"
        },
        "rate_limited": {
          "title": "Rate Limited",
          "type": "boolean"
        },
        "schema_version": {
          "const": "2.0",
          "title": "Schema Version",
          "type": "string"
        },
        "serialization": {
          "$ref": "#/$defs/SerializationContract"
        },
        "timing": {
          "$ref": "#/$defs/TimingChannelContract"
        }
      },
      "required": [
        "schema_version",
        "protocol_type",
        "access",
        "outputs",
        "output_channels",
        "adaptive_queries",
        "authenticated",
        "rate_limited",
        "timing",
        "errors",
        "execution",
        "access_paths",
        "serialization"
      ],
      "title": "InterfaceContract",
      "type": "object"
    },
    "LlmProtocolContract": {
      "additionalProperties": false,
      "properties": {
        "adapter_sha256s": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Adapter Sha256S",
          "type": "array"
        },
        "decoding_parameters": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "minProperties": 1,
          "title": "Decoding Parameters",
          "type": "object"
        },
        "filter_bundle_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Filter Bundle Sha256"
        },
        "logging_mode": {
          "enum": [
            "none",
            "security_only",
            "full_transcript"
          ],
          "title": "Logging Mode",
          "type": "string"
        },
        "maximum_concurrent_sessions": {
          "exclusiveMinimum": 0,
          "title": "Maximum Concurrent Sessions",
          "type": "integer"
        },
        "maximum_lifetime_queries": {
          "exclusiveMinimum": 0,
          "title": "Maximum Lifetime Queries",
          "type": "integer"
        },
        "maximum_session_tokens": {
          "exclusiveMinimum": 0,
          "title": "Maximum Session Tokens",
          "type": "integer"
        },
        "memory_mode": {
          "enum": [
            "none",
            "session",
            "persistent"
          ],
          "title": "Memory Mode",
          "type": "string"
        },
        "memory_ttl_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Memory Ttl Seconds"
        },
        "model_identifier": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Model Identifier",
          "type": "string"
        },
        "model_provider": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Model Provider",
          "type": "string"
        },
        "model_version": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Model Version",
          "type": "string"
        },
        "provider_retention_days": {
          "minimum": 0,
          "title": "Provider Retention Days",
          "type": "integer"
        },
        "reset_semantics": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Reset Semantics",
          "type": "string"
        },
        "retrieval_corpus_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retrieval Corpus Sha256"
        },
        "retriever_config_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retriever Config Sha256"
        },
        "system_prompt_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "System Prompt Sha256",
          "type": "string"
        },
        "tokenizer_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Tokenizer Sha256",
          "type": "string"
        },
        "tool_names": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Tool Names",
          "type": "array"
        },
        "tool_policy_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Policy Sha256"
        },
        "update_policy": {
          "enum": [
            "immutable",
            "versioned_reassessment_required"
          ],
          "title": "Update Policy",
          "type": "string"
        },
        "valid_until": {
          "format": "date-time",
          "title": "Valid Until",
          "type": "string"
        }
      },
      "required": [
        "model_provider",
        "model_identifier",
        "model_version",
        "tokenizer_sha256",
        "decoding_parameters",
        "system_prompt_sha256",
        "memory_mode",
        "logging_mode",
        "provider_retention_days",
        "maximum_session_tokens",
        "maximum_lifetime_queries",
        "maximum_concurrent_sessions",
        "reset_semantics",
        "update_policy",
        "valid_until"
      ],
      "title": "LlmProtocolContract",
      "type": "object"
    },
    "OutputChannelContract": {
