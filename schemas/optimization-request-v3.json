    "PolicyReference": {
      "additionalProperties": false,
      "properties": {
        "policy_id": {
          "maxLength": 128,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "title": "Policy Id",
          "type": "string"
        },
        "policy_path": {
          "minLength": 1,
          "title": "Policy Path",
          "type": "string"
        },
        "policy_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Policy Sha256",
          "type": "string"
        },
        "policy_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Policy Version",
          "type": "string"
        }
      },
      "required": [
        "policy_id",
        "policy_version",
        "policy_path",
        "policy_sha256"
      ],
      "title": "PolicyReference",
      "type": "object"
    },
    "PortfolioAssuranceStatus": {
      "enum": [
        "analytically_composed",
        "directly_joint_assessed",
        "unassessed"
      ],
      "title": "PortfolioAssuranceStatus",
      "type": "string"
    },
    "PortfolioCertificate": {
      "additionalProperties": false,
      "properties": {
        "composition_domain_id": {
          "maxLength": 256,
          "minLength": 3,
          "title": "Composition Domain Id",
          "type": "string"
        },
        "evidence_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Path"
        },
        "evidence_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Sha256"
        },
        "joint_experiment_ids": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Joint Experiment Ids",
          "type": "object"
        },
        "joint_upper_bounds": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Joint Upper Bounds",
          "type": "object"
        },
        "method": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Method",
          "type": "string"
        },
        "population_secret_pairs": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Population Secret Pairs",
          "type": "array"
        },
        "registered_release_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Registered Release Ids",
          "type": "array"
        },
        "registry_head_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Registry Head Sha256",
          "type": "string"
        },
        "registry_sequence": {
          "minimum": 0,
          "title": "Registry Sequence",
          "type": "integer"
        },
        "status": {
          "$ref": "#/$defs/PortfolioAssuranceStatus"
        }
      },
      "required": [
        "status",
        "composition_domain_id",
        "population_secret_pairs",
        "registry_head_sha256",
        "registry_sequence",
        "method"
      ],
      "title": "PortfolioCertificate",
      "type": "object"
    },
    "PortfolioRegistrySnapshot": {
      "additionalProperties": false,
      "description": "Hash-bound authoritative view of releases active before the candidate.",
      "properties": {
        "active_release_ids": {
