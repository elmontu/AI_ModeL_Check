{
  "additionalProperties": false,
  "description": "Portable head/count statement to anchor outside the local SQLite file.",
  "properties": {
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "event_count": {
      "minimum": 0,
      "title": "Event Count",
      "type": "integer"
    },
    "head_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Head Sha256",
      "type": "string"
    },
    "last_sequence": {
      "minimum": 0,
      "title": "Last Sequence",
      "type": "integer"
    },
    "ledger_id": {
      "format": "uuid",
      "title": "Ledger Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "ledger_id",
    "event_count",
    "last_sequence",
    "head_sha256",
    "created_at"
  ],
  "title": "AuditCheckpoint",
  "type": "object"
}
