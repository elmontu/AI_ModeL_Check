{
  "$defs": {
    "AnalyzerProvenance": {
      "additionalProperties": false,
      "properties": {
        "bound_fields": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Bound Fields",
          "type": "array"
        },
        "source_path": {
          "minLength": 1,
          "title": "Source Path",
          "type": "string"
        },
        "source_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Sha256",
          "type": "string"
        },
        "tool": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Tool",
          "type": "string"
        },
        "tool_version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Tool Version",
          "type": "string"
        }
      },
      "required": [
        "tool",
        "tool_version",
        "source_path",
        "source_sha256",
        "bound_fields"
      ],
      "title": "AnalyzerProvenance",
      "type": "object"
    },
    "AttackInput": {
      "additionalProperties": false,
      "properties": {
        "analyzer": {
          "const": "attack",
          "default": "attack",
          "title": "Analyzer",
          "type": "string"
        },
        "attack_name": {
          "minLength": 1,
          "title": "Attack Name",
          "type": "string"
        },
        "audit_disjoint": {
          "title": "Audit Disjoint",
          "type": "boolean"
        },
        "calibration_disjoint": {
          "title": "Calibration Disjoint",
          "type": "boolean"
        },
        "comparison_family_size": {
          "default": 1,
          "minimum": 1,
          "title": "Comparison Family Size",
          "type": "integer"
        },
        "confidence": {
          "default": 0.95,
          "exclusiveMaximum": 1.0,
          "exclusiveMinimum": 0.5,
          "title": "Confidence",
          "type": "number"
        },
        "evidence_context": {
          "$ref": "#/$defs/EvidenceContext"
        },
        "false_positives": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "False Positives"
        },
        "metric": {
          "enum": [
            "membership_tpr_at_fpr",
            "equal_prior_membership_success",
            "finite_secret_exact_guess_success",
            "attribute_attack_success",
            "reconstruction_success"
          ],
          "title": "Metric",
          "type": "string"
        },
        "nonmember_trials": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Nonmember Trials"
        },
        "population_scope_id": {
          "title": "Population Scope Id",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/AnalyzerProvenance"
        },
        "raw_counts_retained": {
          "default": true,
          "title": "Raw Counts Retained",
          "type": "boolean"
        },
        "successes": {
          "minimum": 0,
          "title": "Successes",
          "type": "integer"
        },
        "target_fpr": {
          "anyOf": [
            {
              "exclusiveMaximum": 1.0,
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Fpr"
        },
        "threat_id": {
          "title": "Threat Id",
          "type": "string"
        },
        "threshold_pre_registered": {
          "default": true,
          "title": "Threshold Pre Registered",
          "type": "boolean"
        },
        "trials": {
          "exclusiveMinimum": 0,
          "title": "Trials",
          "type": "integer"
        }
      },
      "required": [
        "threat_id",
        "population_scope_id",
        "attack_name",
        "metric",
        "successes",
        "trials",
        "calibration_disjoint",
        "audit_disjoint",
        "evidence_context",
        "provenance"
      ],
      "title": "AttackInput",
      "type": "object"
    },
    "ControlledInferenceInput": {
      "additionalProperties": false,
      "properties": {
        "analyzer": {
          "const": "controlled_inference",
          "default": "controlled_inference",
          "title": "Analyzer",
          "type": "string"
        },
        "attack_name": {
          "minLength": 1,
          "title": "Attack Name",
          "type": "string"
        },
        "attack_training_disjoint": {
          "title": "Attack Training Disjoint",
          "type": "boolean"
        },
        "audit_disjoint": {
          "title": "Audit Disjoint",
          "type": "boolean"
        },
        "baseline_only_successes": {
          "minimum": 0,
          "title": "Baseline Only Successes",
          "type": "integer"
        },
        "baseline_successes": {
          "minimum": 0,
          "title": "Baseline Successes",
          "type": "integer"
        },
        "combined_only_successes": {
          "minimum": 0,
          "title": "Combined Only Successes",
          "type": "integer"
        },
        "combined_successes": {
          "minimum": 0,
          "title": "Combined Successes",
          "type": "integer"
        },
        "comparator_same_side_information": {
          "title": "Comparator Same Side Information",
          "type": "boolean"
        },
        "comparison_family_size": {
          "default": 1,
          "minimum": 1,
          "title": "Comparison Family Size",
          "type": "integer"
        },
        "confidence_family": {
          "default": 0.95,
          "exclusiveMaximum": 1.0,
          "exclusiveMinimum": 0.5,
          "title": "Confidence Family",
          "type": "number"
        },
        "evidence_context": {
          "$ref": "#/$defs/EvidenceContext"
        },
        "ground_truth_verified": {
          "title": "Ground Truth Verified",
          "type": "boolean"
        },
        "metric": {
          "enum": [
            "attribute_attack_success",
            "incremental_attribute_attack_success",
            "reconstruction_success",
            "incremental_reconstruction_success"
          ],
          "title": "Metric",
          "type": "string"
        },
        "population_scope_id": {
          "title": "Population Scope Id",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/AnalyzerProvenance"
        },
        "raw_paired_counts_retained": {
          "title": "Raw Paired Counts Retained",
          "type": "boolean"
        },
        "secret_and_metric_pre_registered": {
          "title": "Secret And Metric Pre Registered",
          "type": "boolean"
        },
        "success_definition": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Success Definition",
          "type": "string"
        },
        "threat_id": {
          "title": "Threat Id",
          "type": "string"
        },
        "training_membership_verified": {
          "default": false,
          "title": "Training Membership Verified",
          "type": "boolean"
        },
        "trials": {
          "exclusiveMinimum": 0,
          "title": "Trials",
          "type": "integer"
        }
      },
      "required": [
        "threat_id",
        "population_scope_id",
        "attack_name",
        "metric",
        "trials",
        "combined_successes",
        "baseline_successes",
        "combined_only_successes",
        "baseline_only_successes",
        "attack_training_disjoint",
        "audit_disjoint",
        "raw_paired_counts_retained",
        "comparator_same_side_information",
        "secret_and_metric_pre_registered",
        "ground_truth_verified",
        "success_definition",
        "evidence_context",
        "provenance"
      ],
      "title": "ControlledInferenceInput",
      "type": "object"
    },
    "DataModality": {
      "enum": [
        "tabular",
        "text",
        "image",
        "audio",
        "video",
        "time_series",
        "graph",
        "geospatial",
        "embedding",
        "action",
        "multimodal",
        "custom"
      ],
      "title": "DataModality",
      "type": "string"
    },
    "DpInput": {
      "additionalProperties": false,
      "properties": {
        "accountant": {
          "minLength": 1,
          "title": "Accountant",
          "type": "string"
        },
        "accountant_replayed": {
          "title": "Accountant Replayed",
          "type": "boolean"
        },
        "adjacency": {
          "minLength": 1,
          "title": "Adjacency",
          "type": "string"
        },
        "analyzer": {
          "const": "dp",
          "default": "dp",
          "title": "Analyzer",
          "type": "string"
        },
        "complete_pipeline": {
          "title": "Complete Pipeline",
          "type": "boolean"
        },
        "delta": {
          "exclusiveMaximum": 1.0,
          "minimum": 0.0,
          "title": "Delta",
          "type": "number"
        },
        "epsilon": {
          "minimum": 0.0,
          "title": "Epsilon",
          "type": "number"
        },
        "evidence_context": {
          "$ref": "#/$defs/EvidenceContext"
        },
        "fpr": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fpr"
        },
        "pairwise_secret_relation_validated": {
          "default": false,
          "title": "Pairwise Secret Relation Validated",
          "type": "boolean"
        },
        "population_scope_id": {
          "title": "Population Scope Id",
          "type": "string"
        },
        "protected_unit": {
          "minLength": 1,
          "title": "Protected Unit",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/AnalyzerProvenance"
        },
        "secret_cardinality": {
          "anyOf": [
            {
              "minimum": 2,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Secret Cardinality"
        },
        "threat_id": {
          "title": "Threat Id",
          "type": "string"
        }
      },
      "required": [
        "threat_id",
        "population_scope_id",
        "epsilon",
        "delta",
        "adjacency",
        "protected_unit",
        "accountant",
        "accountant_replayed",
        "complete_pipeline",
        "evidence_context",
        "provenance"
      ],
      "title": "DpInput",
      "type": "object"
    },
    "EvidenceContext": {
      "additionalProperties": false,
      "properties": {
        "artifact_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Artifact Sha256",
          "type": "string"
        },
        "decision_game_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Decision Game Sha256",
          "type": "string"
        },
        "interface_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Interface Sha256",
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "policy_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Policy Sha256",
          "type": "string"
        },
        "population_scope_id": {
          "maxLength": 128,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "title": "Population Scope Id",
          "type": "string"
        },
        "population_scope_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Population Scope Sha256",
          "type": "string"
        },
        "release_contract_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Release Contract Sha256",
          "type": "string"
        },
        "release_id": {
          "maxLength": 128,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "title": "Release Id",
          "type": "string"
        }
      },
      "required": [
        "release_id",
        "release_contract_sha256",
        "policy_sha256",
        "artifact_sha256",
        "interface_sha256",
        "population_scope_id",
        "population_scope_sha256",
        "decision_game_sha256",
        "observed_at"
      ],
      "title": "EvidenceContext",
      "type": "object"
    },
    "InterfaceContract": {
      "additionalProperties": false,
      "properties": {
        "access": {
          "enum": [
            "aggregate",
            "label",
            "score",
            "text",
            "embedding",
            "gradient",
            "weights",
            "full_artifact"
          ],
          "title": "Access",
          "type": "string"
        },
        "adaptive_queries": {
          "default": false,
          "title": "Adaptive Queries",
          "type": "boolean"
        },
        "authenticated": {
          "default": false,
          "title": "Authenticated",
          "type": "boolean"
        },
        "llm_protocol": {
          "anyOf": [
            {
              "$ref": "#/$defs/LlmProtocolContract"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "notes": {
          "default": "",
          "title": "Notes",
          "type": "string"
        },
        "outputs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Outputs",
          "type": "array"
        },
        "precision_bits": {
          "anyOf": [
            {
              "maximum": 4096,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Precision Bits"
        },
        "protocol_type": {
          "default": "predictive",
          "enum": [
            "predictive",
            "interactive_llm"
          ],
          "title": "Protocol Type",
          "type": "string"
        },
        "query_budget": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Query Budget"
        },
        "rate_limited": {
          "default": false,
          "title": "Rate Limited",
          "type": "boolean"
        }
      },
      "required": [
        "access"
      ],
      "title": "InterfaceContract",
      "type": "object"
    },
    "LlmProtocolContract": {
      "additionalProperties": false,
      "properties": {
        "adapter_sha256s": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Adapter Sha256S",
          "type": "array"
        },
        "decoding_parameters": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "minProperties": 1,
          "title": "Decoding Parameters",
          "type": "object"
        },
        "filter_bundle_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Filter Bundle Sha256"
        },
        "logging_mode": {
          "enum": [
            "none",
            "security_only",
            "full_transcript"
          ],
          "title": "Logging Mode",
          "type": "string"
        },
        "maximum_concurrent_sessions": {
          "exclusiveMinimum": 0,
          "title": "Maximum Concurrent Sessions",
          "type": "integer"
        },
        "maximum_lifetime_queries": {
          "exclusiveMinimum": 0,
          "title": "Maximum Lifetime Queries",
          "type": "integer"
        },
        "maximum_session_tokens": {
          "exclusiveMinimum": 0,
          "title": "Maximum Session Tokens",
          "type": "integer"
        },
        "memory_mode": {
          "enum": [
            "none",
            "session",
            "persistent"
          ],
          "title": "Memory Mode",
          "type": "string"
        },
        "memory_ttl_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Memory Ttl Seconds"
        },
        "model_identifier": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Model Identifier",
          "type": "string"
        },
        "model_provider": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Model Provider",
          "type": "string"
        },
        "model_version": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Model Version",
          "type": "string"
        },
        "provider_retention_days": {
          "minimum": 0,
          "title": "Provider Retention Days",
          "type": "integer"
        },
        "reset_semantics": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Reset Semantics",
          "type": "string"
        },
        "retrieval_corpus_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retrieval Corpus Sha256"
        },
        "retriever_config_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retriever Config Sha256"
        },
        "system_prompt_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "System Prompt Sha256",
          "type": "string"
        },
        "tokenizer_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Tokenizer Sha256",
          "type": "string"
        },
        "tool_names": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Tool Names",
          "type": "array"
        },
        "tool_policy_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Policy Sha256"
        },
        "update_policy": {
          "enum": [
            "immutable",
            "versioned_reassessment_required"
          ],
          "title": "Update Policy",
          "type": "string"
        },
        "valid_until": {
          "format": "date-time",
          "title": "Valid Until",
          "type": "string"
        }
      },
      "required": [
        "model_provider",
        "model_identifier",
        "model_version",
        "tokenizer_sha256",
        "decoding_parameters",
        "system_prompt_sha256",
        "memory_mode",
        "logging_mode",
        "provider_retention_days",
        "maximum_session_tokens",
        "maximum_lifetime_queries",
        "maximum_concurrent_sessions",
        "reset_semantics",
        "update_policy",
        "valid_until"
      ],
      "title": "LlmProtocolContract",
      "type": "object"
    },
    "ModelProfile": {
      "additionalProperties": false,
      "properties": {
        "component_model_families": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Component Model Families",
          "type": "array"
        },
        "custom_task_definition": {
          "anyOf": [
            {
              "maxLength": 2048,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Custom Task Definition"
        },
        "generative": {
          "default": false,
          "title": "Generative",
          "type": "boolean"
        },
        "input_modalities": {
          "items": {
            "$ref": "#/$defs/DataModality"
          },
          "minItems": 1,
          "title": "Input Modalities",
          "type": "array"
        },
        "output_modalities": {
          "items": {
            "$ref": "#/$defs/DataModality"
          },
          "minItems": 1,
          "title": "Output Modalities",
          "type": "array"
        },
        "stateful": {
          "default": false,
          "title": "Stateful",
          "type": "boolean"
        },
        "task": {
          "$ref": "#/$defs/ModelTask"
        },
        "training_paradigm": {
          "$ref": "#/$defs/TrainingParadigm"
        }
      },
      "required": [
        "task",
        "input_modalities",
        "output_modalities",
        "training_paradigm"
      ],
      "title": "ModelProfile",
      "type": "object"
    },
    "ModelTask": {
      "enum": [
        "classification",
        "regression",
        "ranking",
        "recommendation",
        "forecasting",
        "clustering",
        "anomaly_detection",
        "representation",
        "generation",
        "retrieval",
        "control",
        "decision_support",
        "custom"
      ],
      "title": "ModelTask",
      "type": "string"
    },
    "PolicyReference": {
      "additionalProperties": false,
      "properties": {
        "policy_id": {
          "maxLength": 128,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "title": "Policy Id",
          "type": "string"
        },
        "policy_path": {
          "minLength": 1,
          "title": "Policy Path",
          "type": "string"
        },
        "policy_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Policy Sha256",
          "type": "string"
        },
        "policy_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Policy Version",
          "type": "string"
        }
      },
      "required": [
        "policy_id",
        "policy_version",
        "policy_path",
        "policy_sha256"
      ],
      "title": "PolicyReference",
      "type": "object"
    },
    "PopulationInput": {
      "additionalProperties": false,
      "properties": {
        "analyzer": {
          "const": "population",
          "default": "population",
          "title": "Analyzer",
          "type": "string"
        },
        "coverage": {
          "exclusiveMaximum": 1.0,
          "exclusiveMinimum": 0.5,
          "title": "Coverage",
          "type": "number"
        },
        "evidence_context": {
          "$ref": "#/$defs/EvidenceContext"
        },
        "fitted_joint_model": {
          "title": "Fitted Joint Model",
          "type": "boolean"
        },
        "heldout_validated": {
          "title": "Heldout Validated",
          "type": "boolean"
        },
        "multiplicity_adjusted": {
          "title": "Multiplicity Adjusted",
          "type": "boolean"
        },
        "population_scope_id": {
          "title": "Population Scope Id",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/AnalyzerProvenance"
        },
        "required_match_count": {
          "exclusiveMinimum": 0.0,
          "title": "Required Match Count",
          "type": "number"
        },
        "simultaneous_lower_match_count": {
          "minimum": 0.0,
          "title": "Simultaneous Lower Match Count",
          "type": "number"
        },
        "threat_id": {
          "title": "Threat Id",
          "type": "string"
        }
