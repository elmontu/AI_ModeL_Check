      },
      "required": [
        "certificate_id",
        "dominant_experiment_id",
        "dominated_experiment_id",
        "kernel",
        "construction"
      ],
      "title": "GarblingCertificate",
      "type": "object"
    },
    "InterfaceContract": {
      "additionalProperties": false,
      "properties": {
        "access": {
