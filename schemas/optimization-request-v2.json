    "GarblingCertificate": {
      "additionalProperties": false,
      "description": "Replayable exact/approximate witness that dominated is a garbling of dominant.",
      "properties": {
        "certificate_id": {
          "maxLength": 128,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9._:-]+$",
