{
  "$defs": {
    "ReleaseProtocolState": {
      "enum": [
        "draft",
        "registered",
        "plan_frozen",
        "evidence_frozen",
        "assessed",
        "optimized",
        "commit_pending",
        "authorized",
        "active",
        "suspended",
        "revoked",
        "expired",
        "redesign_required",
        "rejected",
        "aborted"
      ],
      "title": "ReleaseProtocolState",
      "type": "string"
    },
    "ReleaseProtocolVerificationCheck": {
      "enum": [
        "artifact_file_digests",
        "authenticated_signatures"
      ],
      "title": "ReleaseProtocolVerificationCheck",
      "type": "string"
    },
    "ReleaseProtocolVerificationDegradation": {
      "enum": [
        "artifact_file_verification_skipped",
        "structural_profile_only"
      ],
      "title": "ReleaseProtocolVerificationDegradation",
      "type": "string"
    },
    "ReleaseProtocolVerificationProfile": {
      "enum": [
        "structural_v1",
        "authenticated_v1"
      ],
      "title": "ReleaseProtocolVerificationProfile",
      "type": "string"
    },
    "RuntimeIdentity": {
      "additionalProperties": false,
      "description": "Replayable identity of the software component that emitted an artifact.",
      "properties": {
        "algorithm_profile": {
          "additionalProperties": true,
          "title": "Algorithm Profile",
          "type": "object"
        },
        "algorithm_profile_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Algorithm Profile Sha256",
          "type": "string"
        },
        "component_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Component Id",
          "type": "string"
        },
        "component_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Component Version",
          "type": "string"
        },
        "dependency_versions": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Dependency Versions",
          "type": "object"
        },
        "package_name": {
          "const": "model-release-assurance",
          "default": "model-release-assurance",
          "title": "Package Name",
          "type": "string"
        },
        "package_source_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Package Source Sha256",
          "type": "string"
        },
        "package_version": {
          "title": "Package Version",
          "type": "string"
        },
        "python_implementation": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Python Implementation",
          "type": "string"
        },
        "python_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Python Version",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "package_version",
        "package_source_sha256",
        "component_id",
        "component_version",
        "algorithm_profile",
        "algorithm_profile_sha256",
        "python_implementation",
        "python_version",
        "dependency_versions"
      ],
      "title": "RuntimeIdentity",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "artifact_files_verified": {
      "title": "Artifact Files Verified",
      "type": "boolean"
    },
    "authenticated_signatures_verified": {
      "title": "Authenticated Signatures Verified",
      "type": "boolean"
    },
    "authorization_issued": {
      "title": "Authorization Issued",
      "type": "boolean"
    },
    "degradations": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ReleaseProtocolVerificationDegradation"
      },
      "title": "Degradations",
      "type": "array",
      "uniqueItems": true
    },
    "deployment_active": {
      "title": "Deployment Active",
      "type": "boolean"
    },
    "event_sha256s": {
      "items": {
        "type": "string"
      },
      "title": "Event Sha256S",
      "type": "array"
    },
    "final_state": {
      "$ref": "#/$defs/ReleaseProtocolState"
    },
    "reasons": {
      "items": {
        "type": "string"
      },
      "title": "Reasons",
      "type": "array"
    },
    "run_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Run Sha256",
      "type": "string"
    },
    "runtime_identity": {
      "$ref": "#/$defs/RuntimeIdentity"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "skipped_checks": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ReleaseProtocolVerificationCheck"
      },
      "title": "Skipped Checks",
      "type": "array",
      "uniqueItems": true
    },
    "valid": {
      "title": "Valid",
      "type": "boolean"
    },
    "verification_profile": {
      "$ref": "#/$defs/ReleaseProtocolVerificationProfile"
    },
    "verification_time": {
      "format": "date-time",
      "title": "Verification Time",
      "type": "string"
    }
  },
  "required": [
    "verification_profile",
    "artifact_files_verified",
    "authenticated_signatures_verified",
    "verification_time",
    "run_sha256",
    "runtime_identity",
    "valid",
    "final_state",
    "authorization_issued",
    "deployment_active",
    "event_sha256s",
    "reasons"
  ],
  "title": "ReleaseProtocolVerification",
  "type": "object"
}
