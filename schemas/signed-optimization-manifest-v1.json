{
  "$defs": {
    "OptimizationOutcome": {
      "enum": [
        "release_as_proposed",
        "release_with_controls",
        "redesign_required",
        "reject"
      ],
      "title": "OptimizationOutcome",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "canonicalization": {
      "const": "MRA-PY-JSON-1",
      "default": "MRA-PY-JSON-1",
      "title": "Canonicalization",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "fail_safe_gate_passed": {
      "title": "Fail Safe Gate Passed",
      "type": "boolean"
    },
    "optimization_id": {
      "title": "Optimization Id",
      "type": "string"
    },
    "outcome": {
      "$ref": "#/$defs/OptimizationOutcome"
    },
    "policy_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Policy Sha256",
      "type": "string"
    },
    "report_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Report Sha256",
      "type": "string"
    },
    "request_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Request Sha256",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "selected_assessment_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Selected Assessment Id"
    },
    "selected_assessment_report_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Selected Assessment Report Sha256"
    },
    "selected_configuration_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Selected Configuration Id"
    },
    "selected_control_ids": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Selected Control Ids",
      "type": "array"
    },
    "selected_release_artifact_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Selected Release Artifact Sha256"
    },
    "selected_release_interface_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Selected Release Interface Sha256"
    },
    "signature_algorithm": {
      "const": "Ed25519",
      "default": "Ed25519",
      "title": "Signature Algorithm",
      "type": "string"
    },
    "signature_b64": {
      "minLength": 1,
      "title": "Signature B64",
      "type": "string"
    },
    "signer_key_id": {
      "pattern": "^[0-9a-f]{24}$",
      "title": "Signer Key Id",
      "type": "string"
    }
  },
  "required": [
    "optimization_id",
    "request_sha256",
    "report_sha256",
    "policy_sha256",
    "outcome",
    "selected_configuration_id",
    "selected_assessment_id",
    "fail_safe_gate_passed",
    "created_at",
    "signer_key_id",
    "signature_b64"
  ],
  "title": "SignedOptimizationManifest",
  "type": "object"
}
