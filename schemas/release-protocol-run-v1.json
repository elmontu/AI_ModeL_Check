{
  "$defs": {
    "ControlStatus": {
      "enum": [
        "pass",
        "fail",
        "not_applicable"
      ],
      "title": "ControlStatus",
      "type": "string"
    },
    "MonitoringOutcome": {
      "enum": [
        "continue",
        "suspend",
        "revoke",
        "expire"
      ],
      "title": "MonitoringOutcome",
      "type": "string"
    },
    "OptimizationOutcome": {
      "enum": [
        "release_as_proposed",
        "release_with_controls",
        "redesign_required",
        "reject"
      ],
      "title": "OptimizationOutcome",
      "type": "string"
    },
    "OverallVerdict": {
      "enum": [
        "clear",
        "block",
        "inconclusive"
      ],
      "title": "OverallVerdict",
      "type": "string"
    },
    "ReleaseProtocolActor": {
      "additionalProperties": false,
      "properties": {
        "actor_id": {
          "maxLength": 128,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "title": "Actor Id",
          "type": "string"
        },
        "key_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Key Id",
          "type": "string"
        },
        "organization": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Organization",
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/ReleaseProtocolRole"
        }
      },
      "required": [
        "actor_id",
        "role",
        "organization",
        "key_id"
      ],
      "title": "ReleaseProtocolActor",
      "type": "object"
    },
    "ReleaseProtocolArtifact": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "maxLength": 128,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "title": "Artifact Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ReleaseProtocolArtifactKind"
        },
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "producer_actor_id": {
          "maxLength": 128,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "title": "Producer Actor Id",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "kind",
        "path",
        "sha256",
        "producer_actor_id"
      ],
      "title": "ReleaseProtocolArtifact",
      "type": "object"
    },
    "ReleaseProtocolArtifactKind": {
      "enum": [
        "registration",
        "policy_snapshot",
        "release_instance",
        "population_register",
        "threat_register",
        "portfolio_snapshot",
        "evidence_plan",
        "assurance_error_budget",
        "monitoring_plan",
        "evidence_bundle",
        "assessment_report",
        "optimization_report",
        "authorization_commit_request",
        "authorization_receipt",
        "portfolio_commit",
        "activation_receipt",
        "monitoring_report",
        "incident_record",
        "decommission_record",
        "abort_record"
      ],
      "title": "ReleaseProtocolArtifactKind",
      "type": "string"
    },
    "ReleaseProtocolEvent": {
      "additionalProperties": false,
      "properties": {
        "actor_id": {
          "maxLength": 128,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "title": "Actor Id",
          "type": "string"
        },
        "actor_role": {
          "$ref": "#/$defs/ReleaseProtocolRole"
        },
        "artifacts": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ReleaseProtocolArtifact"
          },
          "title": "Artifacts",
          "type": "array"
        },
        "assessment_verdict": {
          "anyOf": [
            {
              "$ref": "#/$defs/OverallVerdict"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "assurance_alpha_budget": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Assurance Alpha Budget"
        },
        "assurance_alpha_spent": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Assurance Alpha Spent"
        },
        "atomic_compare_and_swap_succeeded": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Atomic Compare And Swap Succeeded"
        },
        "authorization_expires_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Authorization Expires At"
        },
        "committed_registry_head_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Committed Registry Head Sha256"
        },
        "deployed_artifact_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Deployed Artifact Sha256"
        },
        "deployed_interface_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Deployed Interface Sha256"
        },
        "event_id": {
          "maxLength": 128,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "title": "Event Id",
          "type": "string"
        },
        "event_type": {
          "$ref": "#/$defs/ReleaseProtocolEventType"
        },
        "exhaustive_search_replayed": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exhaustive Search Replayed"
        },
        "expected_registry_head_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Registry Head Sha256"
        },
        "mandatory_evidence_complete": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mandatory Evidence Complete"
        },
        "monitoring_outcome": {
          "anyOf": [
            {
              "$ref": "#/$defs/MonitoringOutcome"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "occurred_at": {
          "format": "date-time",
          "title": "Occurred At",
          "type": "string"
        },
        "optimization_outcome": {
          "anyOf": [
            {
              "$ref": "#/$defs/OptimizationOutcome"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "positive_control_status": {
          "anyOf": [
            {
              "$ref": "#/$defs/ControlStatus"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "previous_event_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Previous Event Sha256"
        },
        "reason": {
          "default": "",
          "maxLength": 4096,
          "title": "Reason",
          "type": "string"
        },
        "selected_configuration_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 3,
              "pattern": "^[A-Za-z0-9._:-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Selected Configuration Id"
        },
        "selection_coverage_valid": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Selection Coverage Valid"
        },
        "sequence": {
          "minimum": 1,
          "title": "Sequence",
          "type": "integer"
        }
      },
      "required": [
        "sequence",
        "event_id",
        "event_type",
        "occurred_at",
        "actor_id",
        "actor_role"
      ],
      "title": "ReleaseProtocolEvent",
      "type": "object"
    },
    "ReleaseProtocolEventType": {
      "enum": [
        "register_scope",
        "approve_evidence_plan",
        "close_evidence",
        "record_assessment",
        "record_selection",
        "submit_authorization",
        "commit_portfolio",
        "activate_deployment",
        "review_monitoring",
        "suspend_release",
        "revoke_release",
        "expire_release",
        "abort_release"
      ],
      "title": "ReleaseProtocolEventType",
      "type": "string"
    },
    "ReleaseProtocolRole": {
      "enum": [
        "model_owner",
        "policy_authority",
        "population_steward",
        "configuration_generator",
        "evidence_authority",
        "independent_assessor",
        "optimization_authority",
        "authorization_authority",
        "portfolio_registry",
        "deployment_gateway",
        "monitoring_authority",
        "incident_authority"
      ],
      "title": "ReleaseProtocolRole",
      "type": "string"
    },
    "ReleaseProtocolState": {
      "enum": [
        "draft",
        "registered",
        "plan_frozen",
        "evidence_frozen",
        "assessed",
        "optimized",
        "commit_pending",
        "authorized",
        "active",
        "suspended",
        "revoked",
        "expired",
        "redesign_required",
        "rejected",
        "aborted"
      ],
      "title": "ReleaseProtocolState",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "actors": {
      "items": {
        "$ref": "#/$defs/ReleaseProtocolActor"
      },
      "title": "Actors",
      "type": "array"
    },
    "artifact_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Artifact Sha256",
      "type": "string"
    },
    "claimed_state": {
      "$ref": "#/$defs/ReleaseProtocolState"
    },
    "events": {
      "items": {
        "$ref": "#/$defs/ReleaseProtocolEvent"
      },
      "minItems": 1,
      "title": "Events",
      "type": "array"
    },
    "interface_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Interface Sha256",
      "type": "string"
    },
    "policy_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Policy Sha256",
      "type": "string"
    },
    "population_scope_sha256s": {
      "additionalProperties": {
        "type": "string"
      },
      "minProperties": 1,
      "title": "Population Scope Sha256S",
      "type": "object"
    },
    "protocol_id": {
      "const": "MRAP/1.0",
      "default": "MRAP/1.0",
      "title": "Protocol Id",
      "type": "string"
    },
    "registered_portfolio_head_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Registered Portfolio Head Sha256",
      "type": "string"
    },
    "release_id": {
      "maxLength": 128,
      "minLength": 3,
      "pattern": "^[A-Za-z0-9._:-]+$",
      "title": "Release Id",
      "type": "string"
    },
    "release_instance_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Release Instance Sha256",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "release_id",
    "release_instance_sha256",
    "artifact_sha256",
    "interface_sha256",
    "policy_sha256",
    "population_scope_sha256s",
    "registered_portfolio_head_sha256",
    "actors",
    "events",
    "claimed_state"
  ],
  "title": "ReleaseProtocolRun",
  "type": "object"
}
