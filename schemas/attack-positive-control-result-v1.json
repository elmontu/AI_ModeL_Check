{
  "additionalProperties": false,
  "properties": {
    "attack_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:-]+$",
      "title": "Attack Id",
      "type": "string"
    },
    "attack_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "Attack Version",
      "type": "string"
    },
    "control_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:-]+$",
      "title": "Control Id",
      "type": "string"
    },
    "expected_flag_observed": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expected Flag Observed"
    },
    "implementation_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Implementation Sha256",
      "type": "string"
    },
    "raw_result_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Raw Result Sha256",
      "type": "string"
    },
    "reported_detection_lower_bound": {
      "anyOf": [
        {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reported Detection Lower Bound"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "service_id": {
      "maxLength": 128,
      "minLength": 3,
      "pattern": "^[A-Za-z0-9._:-]+$",
      "title": "Service Id",
      "type": "string"
    },
    "status": {
      "enum": [
        "succeeded",
        "failed",
        "timed_out"
      ],
      "title": "Status",
      "type": "string"
    },
    "successes": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Successes"
    },
    "trials": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Trials"
    }
  },
  "required": [
    "control_id",
    "attack_id",
    "service_id",
    "attack_version",
    "implementation_sha256",
    "status",
    "raw_result_sha256"
  ],
  "title": "AttackPositiveControlResult",
  "type": "object"
}
