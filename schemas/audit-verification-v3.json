{
  "$defs": {
    "RuntimeIdentity": {
      "additionalProperties": false,
      "description": "Replayable identity of the software component that emitted an artifact.",
      "properties": {
        "algorithm_profile": {
          "additionalProperties": true,
          "title": "Algorithm Profile",
          "type": "object"
        },
        "algorithm_profile_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Algorithm Profile Sha256",
          "type": "string"
        },
        "component_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Component Id",
          "type": "string"
        },
        "component_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Component Version",
          "type": "string"
        },
        "dependency_versions": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Dependency Versions",
          "type": "object"
        },
        "package_name": {
          "const": "model-release-assurance",
          "default": "model-release-assurance",
          "title": "Package Name",
          "type": "string"
        },
        "package_source_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Package Source Sha256",
          "type": "string"
        },
        "package_version": {
          "title": "Package Version",
          "type": "string"
        },
        "python_implementation": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Python Implementation",
          "type": "string"
        },
        "python_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Python Version",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "package_version",
        "package_source_sha256",
        "component_id",
        "component_version",
        "algorithm_profile",
        "algorithm_profile_sha256",
        "python_implementation",
        "python_version",
        "dependency_versions"
      ],
      "title": "RuntimeIdentity",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Structured result for one fully replayed local audit chain.",
  "properties": {
    "complete": {
      "title": "Complete",
      "type": "boolean"
    },
    "completed_count": {
      "minimum": 0,
      "title": "Completed Count",
      "type": "integer"
    },
    "diagnostic_degradations": {
      "items": {
        "const": "plaintext_failure_diagnostics_present",
        "type": "string"
      },
      "title": "Diagnostic Degradations",
      "type": "array"
    },
    "domain_separated_hash_event_count": {
      "minimum": 0,
      "title": "Domain Separated Hash Event Count",
      "type": "integer"
    },
    "event_count": {
      "minimum": 0,
      "title": "Event Count",
      "type": "integer"
    },
    "failed_count": {
      "minimum": 0,
      "title": "Failed Count",
      "type": "integer"
    },
    "head_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Head Sha256",
      "type": "string"
    },
    "intent_count": {
      "minimum": 0,
      "title": "Intent Count",
      "type": "integer"
    },
    "last_sequence": {
      "minimum": 0,
      "title": "Last Sequence",
      "type": "integer"
    },
    "ledger_id": {
      "format": "uuid",
      "title": "Ledger Id",
      "type": "string"
    },
    "legacy_event_count": {
      "description": "Count of legacy completion-only assessment_report/optimization_report event types, independently of their hash format.",
      "minimum": 0,
      "title": "Legacy Event Count",
      "type": "integer"
    },
    "legacy_hash_event_count": {
      "description": "Count of rows using the missing or legacy-v1 hash format, independently of their event type.",
      "minimum": 0,
      "title": "Legacy Hash Event Count",
      "type": "integer"
    },
    "orphaned_run_ids": {
      "default": [],
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Orphaned Run Ids",
      "type": "array"
    },
    "plaintext_failure_diagnostic_count": {
      "description": "Count of failed terminal payloads whose diagnostic is not in the redacted:sha256 marker format, including compatible plaintext v2 rows.",
      "minimum": 0,
      "title": "Plaintext Failure Diagnostic Count",
      "type": "integer"
    },
    "redacted_failure_diagnostic_count": {
      "description": "Count of failed terminal payloads whose diagnostic uses the redacted:sha256 marker format.",
      "minimum": 0,
      "title": "Redacted Failure Diagnostic Count",
      "type": "integer"
    },
    "release_ids": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Release Ids",
      "type": "array"
    },
    "release_instance_sha256s": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Release Instance Sha256S",
      "type": "array"
    },
    "runtime_identity": {
      "$ref": "#/$defs/RuntimeIdentity"
    },
    "schema_version": {
      "const": "3.0",
      "default": "3.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "ledger_id",
    "event_count",
    "last_sequence",
    "head_sha256",
    "legacy_event_count",
    "legacy_hash_event_count",
    "domain_separated_hash_event_count",
    "intent_count",
    "completed_count",
    "failed_count",
    "redacted_failure_diagnostic_count",
    "plaintext_failure_diagnostic_count",
    "diagnostic_degradations",
    "complete",
    "runtime_identity"
  ],
  "title": "AuditVerification",
  "type": "object"
}
