{
  "$defs": {
    "ErrorBudgetAllocation": {
      "additionalProperties": false,
      "properties": {
        "allocation_id": {
          "maxLength": 128,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "title": "Allocation Id",
          "type": "string"
        },
        "alpha": {
          "maximum": 0.05,
          "minimum": 1e-08,
          "title": "Alpha",
          "type": "number"
        },
        "binding_context": {
          "anyOf": [
            {
              "$ref": "#/$defs/EvidenceBindingContext"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "family_id": {
          "maxLength": 128,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "title": "Family Id",
          "type": "string"
        },
        "generation_id": {
          "maxLength": 128,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "title": "Generation Id",
          "type": "string"
        },
        "population_scope_id": {
          "maxLength": 128,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "title": "Population Scope Id",
          "type": "string"
        },
        "portfolio_id": {
          "maxLength": 128,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "title": "Portfolio Id",
          "type": "string"
        },
        "sampling_plan_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sampling Plan Sha256",
          "type": "string"
        },
        "status": {
          "const": "committed",
          "default": "committed",
          "title": "Status",
          "type": "string"
        },
        "threat_id": {
          "maxLength": 128,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "title": "Threat Id",
          "type": "string"
        }
      },
      "required": [
        "allocation_id",
        "generation_id",
        "family_id",
        "portfolio_id",
        "population_scope_id",
        "threat_id",
        "sampling_plan_sha256",
        "alpha"
      ],
      "title": "ErrorBudgetAllocation",
      "type": "object"
    },
    "EvidenceBindingContext": {
      "additionalProperties": false,
      "description": "Immutable release identity carried by raw statistical evidence.\n\nThis deliberately excludes an observation timestamp: plans, counts, and\nerror-budget allocations must agree on the release identity before any\nobservation is made, while ``EvidenceContext.observed_at`` records when an\nassessment consumed the resulting evidence.",
      "properties": {
        "artifact_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Artifact Sha256",
          "type": "string"
        },
        "decision_game_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Decision Game Sha256",
          "type": "string"
        },
        "interface_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Interface Sha256",
          "type": "string"
        },
        "policy_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Policy Sha256",
          "type": "string"
        },
        "population_scope_id": {
          "maxLength": 128,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "title": "Population Scope Id",
          "type": "string"
        },
        "population_scope_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Population Scope Sha256",
          "type": "string"
        },
        "release_contract_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Release Contract Sha256",
          "type": "string"
        },
        "release_id": {
          "maxLength": 128,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "title": "Release Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "release_id",
        "release_contract_sha256",
        "policy_sha256",
        "artifact_sha256",
        "interface_sha256",
        "population_scope_id",
        "population_scope_sha256",
        "decision_game_sha256"
      ],
      "title": "EvidenceBindingContext",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "allocations": {
      "items": {
        "$ref": "#/$defs/ErrorBudgetAllocation"
      },
      "minItems": 1,
      "title": "Allocations",
      "type": "array"
    },
    "authority": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Authority",
      "type": "string"
    },
    "budget_id": {
      "maxLength": 128,
      "minLength": 3,
      "pattern": "^[A-Za-z0-9._:-]+$",
      "title": "Budget Id",
      "type": "string"
    },
    "committed_at": {
      "format": "date-time",
      "title": "Committed At",
      "type": "string"
    },
    "period_end": {
      "format": "date",
      "title": "Period End",
      "type": "string"
    },
    "period_start": {
      "format": "date",
      "title": "Period Start",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "total_alpha": {
      "maximum": 0.05,
      "minimum": 1e-08,
      "title": "Total Alpha",
      "type": "number"
    }
  },
  "required": [
    "budget_id",
    "authority",
    "committed_at",
    "period_start",
    "period_end",
    "total_alpha",
    "allocations"
  ],
  "title": "AssuranceErrorBudget",
  "type": "object"
}
