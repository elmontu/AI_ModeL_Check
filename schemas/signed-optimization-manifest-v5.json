{
  "$defs": {
    "InterfaceAssurance": {
      "enum": [
        "declared_interface_only"
      ],
      "title": "InterfaceAssurance",
      "type": "string"
    },
    "OptimizationOutcome": {
      "enum": [
        "release_as_proposed",
        "release_with_controls",
        "redesign_required",
        "reject"
      ],
      "title": "OptimizationOutcome",
      "type": "string"
    },
    "PortfolioAssuranceStatus": {
      "enum": [
        "analytically_composed",
        "directly_joint_assessed",
        "unassessed"
      ],
      "title": "PortfolioAssuranceStatus",
      "type": "string"
    },
    "TrustProfile": {
      "enum": [
        "cooperative",
        "separated_assessor"
      ],
      "title": "TrustProfile",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "authorization_eligible": {
      "const": false,
      "default": false,
      "title": "Authorization Eligible",
      "type": "boolean"
    },
    "canonicalization": {
      "const": "MRA-PY-JSON-1",
      "default": "MRA-PY-JSON-1",
      "title": "Canonicalization",
      "type": "string"
    },
    "composition_domain_id": {
      "title": "Composition Domain Id",
      "type": "string"
    },
    "composition_scope": {
      "const": "portfolio_registry_bound",
      "default": "portfolio_registry_bound",
      "title": "Composition Scope",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "fail_safe_gate_passed": {
      "title": "Fail Safe Gate Passed",
      "type": "boolean"
    },
    "gateway_interface_conformance_required": {
      "const": true,
      "default": true,
      "title": "Gateway Interface Conformance Required",
      "type": "boolean"
    },
    "optimization_id": {
      "title": "Optimization Id",
      "type": "string"
    },
    "outcome": {
      "$ref": "#/$defs/OptimizationOutcome"
    },
    "policy_id": {
      "title": "Policy Id",
      "type": "string"
    },
    "policy_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Policy Sha256",
      "type": "string"
    },
    "policy_version": {
      "title": "Policy Version",
      "type": "string"
    },
    "portfolio_registry_head_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Portfolio Registry Head Sha256",
      "type": "string"
    },
    "portfolio_registry_id": {
      "title": "Portfolio Registry Id",
      "type": "string"
    },
    "portfolio_registry_sequence": {
      "minimum": 0,
      "title": "Portfolio Registry Sequence",
      "type": "integer"
    },
    "report_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Report Sha256",
      "type": "string"
    },
    "request_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Request Sha256",
      "type": "string"
    },
    "schema_version": {
      "const": "5.0",
      "default": "5.0",
      "title": "Schema Version",
      "type": "string"
    },
    "selected_assessment_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Selected Assessment Id"
    },
    "selected_assessment_report_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Selected Assessment Report Sha256"
    },
    "selected_configuration_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Selected Configuration Id"
    },
    "selected_configuration_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Selected Configuration Sha256"
    },
    "selected_control_ids": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Selected Control Ids",
      "type": "array"
    },
    "selected_covered_release_ids": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Selected Covered Release Ids",
      "type": "array"
    },
    "selected_interface_assurance": {
      "anyOf": [
        {
          "$ref": "#/$defs/InterfaceAssurance"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "selected_portfolio_status": {
      "anyOf": [
        {
          "$ref": "#/$defs/PortfolioAssuranceStatus"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "selected_release_artifact_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Selected Release Artifact Sha256"
    },
    "selected_release_interface_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Selected Release Interface Sha256"
    },
    "selection_policy_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Selection Policy Sha256",
      "type": "string"
    },
    "signature_algorithm": {
      "const": "Ed25519",
      "default": "Ed25519",
      "title": "Signature Algorithm",
      "type": "string"
    },
    "signature_b64": {
      "minLength": 1,
      "title": "Signature B64",
      "type": "string"
    },
    "signer_key_id": {
      "pattern": "^[0-9a-f]{24}$",
      "title": "Signer Key Id",
      "type": "string"
    },
    "trust_profile": {
      "$ref": "#/$defs/TrustProfile"
    }
  },
  "required": [
    "optimization_id",
    "request_sha256",
    "report_sha256",
    "policy_id",
    "policy_version",
    "policy_sha256",
    "trust_profile",
    "portfolio_registry_id",
    "portfolio_registry_head_sha256",
    "portfolio_registry_sequence",
    "composition_domain_id",
    "outcome",
    "selected_configuration_id",
    "selected_assessment_id",
    "fail_safe_gate_passed",
    "selection_policy_sha256",
    "created_at",
    "expires_at",
    "signer_key_id",
    "signature_b64"
  ],
  "title": "SignedOptimizationManifest",
  "type": "object"
}
