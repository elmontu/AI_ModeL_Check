{
  "$defs": {
    "PolicyRule": {
      "additionalProperties": false,
      "properties": {
        "decision_metric": {
          "enum": [
            "bayes_linkage_success",
            "incremental_bayes_linkage_success",
            "worst_observation_success",
            "membership_tpr_at_fpr",
            "equal_prior_membership_success",
            "finite_secret_exact_guess_success",
            "attribute_attack_success",
            "incremental_attribute_attack_success",
            "reconstruction_success",
            "incremental_reconstruction_success"
          ],
          "title": "Decision Metric",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ThreatKind"
        },
        "mandatory": {
          "title": "Mandatory",
          "type": "boolean"
        },
        "metric_parameters": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Metric Parameters",
          "type": "object"
        },
        "threat_id": {
          "maxLength": 128,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "title": "Threat Id",
          "type": "string"
        },
        "tolerance": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Tolerance",
          "type": "number"
        },
        "tolerance_basis": {
          "enum": [
            "absolute",
            "incremental"
          ],
          "title": "Tolerance Basis",
          "type": "string"
        }
      },
      "required": [
        "threat_id",
        "kind",
        "mandatory",
        "decision_metric",
        "tolerance",
        "tolerance_basis"
      ],
      "title": "PolicyRule",
      "type": "object"
    },
    "ThreatKind": {
      "enum": [
        "linkage",
        "membership",
        "attribute",
        "reconstruction"
      ],
      "title": "ThreatKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "effective_from": {
      "format": "date-time",
      "title": "Effective From",
      "type": "string"
    },
    "expires_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expires At"
    },
    "policy_id": {
      "maxLength": 128,
      "minLength": 3,
      "pattern": "^[A-Za-z0-9._:-]+$",
      "title": "Policy Id",
      "type": "string"
    },
    "policy_version": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Policy Version",
      "type": "string"
    },
    "rules": {
      "items": {
        "$ref": "#/$defs/PolicyRule"
      },
      "title": "Rules",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "policy_id",
    "policy_version",
    "effective_from",
    "rules"
  ],
  "title": "PolicyBundle",
  "type": "object"
}
