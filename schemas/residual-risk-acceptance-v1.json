{
  "$defs": {
    "RationalProbability": {
      "additionalProperties": false,
      "description": "Canonical exact probability used at security-critical decision boundaries.",
      "properties": {
        "denominator": {
          "exclusiveMinimum": 0,
          "title": "Denominator",
          "type": "integer"
        },
        "numerator": {
          "minimum": 0,
          "title": "Numerator",
          "type": "integer"
        }
      },
      "required": [
        "numerator",
        "denominator"
      ],
      "title": "RationalProbability",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "accepted_ceilings": {
      "additionalProperties": {
        "$ref": "#/$defs/RationalProbability"
      },
      "minProperties": 1,
      "title": "Accepted Ceilings",
      "type": "object"
    },
    "context_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Context Sha256",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "issued_at": {
      "format": "date-time",
      "title": "Issued At",
      "type": "string"
    },
    "reason": {
      "minLength": 20,
      "title": "Reason",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "signature_b64": {
      "minLength": 1,
      "title": "Signature B64",
      "type": "string"
    },
    "signer_key_id": {
      "minLength": 1,
      "title": "Signer Key Id",
      "type": "string"
    }
  },
  "required": [
    "context_sha256",
    "accepted_ceilings",
    "reason",
    "issued_at",
    "expires_at",
    "signer_key_id",
    "signature_b64"
