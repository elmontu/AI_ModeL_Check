FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 OMP_NUM_THREADS=2
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 && rm -rf /var/lib/apt/lists/*
COPY requirements.lock requirements-experiments.txt requirements-console.txt ./
RUN python -m pip install --no-cache-dir -r requirements.lock -r requirements-experiments.txt -r requirements-console.txt
COPY pyproject.toml README.md ./
COPY src ./src
COPY scripts ./scripts
COPY examples ./examples
RUN python -m pip install --no-cache-dir --no-deps -e . && useradd --uid 10001 --create-home mra && mkdir /data && chown mra:mra /data
USER 10001:10001
CMD ["python", "-m", "model_release_assurance.console", "serve", "--host", "0.0.0.0", "--data", "/data"]
