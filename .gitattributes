* text=auto eol=lf

# Evidence manifests bind exact bytes, including frozen implementation sources.
# Preserve these bytes on every platform so a checkout can replay their hashes.
/src/** -text
/scripts/** -text
/schemas/** -text
/examples/** -text
/reproduction/** -text
/academic/** -text
# Runtime locks, test evidence and versioned documents also bind exact bytes.
/deploy/** -text
/tests/** -text
/docs/** -text

# Preserve the Windows single-file launcher and its reproducible download bytes.
/Try-Demo.cmd -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
/demo/Try-Demo.zip -text
