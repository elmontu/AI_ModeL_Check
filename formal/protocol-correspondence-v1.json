      "lean_actions": ["submitAuthorization"],
      "python_roles": ["authorization_authority"]
    },
    "commit_portfolio": {
      "lean_actions": ["commitAuthorization"],
      "python_roles": ["portfolio_registry"]
    },
    "activate_deployment": {
      "lean_actions": ["activate"],
      "python_roles": ["deployment_gateway"]
    },
